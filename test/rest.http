@baseurl = http://localhost:4004/odata/v4

@admin = swapnil:test123
@developer = pratham:pratham123

### 1. Read all the teams.
GET {{baseurl}}/match-centre/Teams

### 2. Read all the players.
GET {{baseurl}}/match-centre/Players

### 3. Read all the Matches.
GET {{baseurl}}/match-centre/Matches

### 4. Read all the Venues.
GET {{baseurl}}/match-centre/Venues

### 5. Read all the Performance.
GET {{baseurl}}/match-centre/Performance

### 6. Read one specific team.
GET {{baseurl}}/match-centre/Teams(T001)

### 7. Find Team by team code
GET {{baseurl}}/match-centre/Teams?$filter=teamCode eq 'CSK'

### 8. Find players belonging to a team
GET {{baseurl}}/match-centre/Players?$filter=team_ID eq 'T001'

### 9. Find teams from a particular city
GET {{baseurl}}/match-centre/Teams?$filter=homeCity eq 'Hyderabad'

### 10. Find players by role
GET {{baseurl}}/match-centre/Players?$filter=role eq 'WicketKeeper'

### 11. Players with their team details 
GET {{baseurl}}/match-centre/Players?$expand=team

### 11. Players with their team details 
GET {{baseurl}}/match-centre/Teams?$expand=players

### 12. Matches with Home team, away team , and venue
GET {{baseurl}}/match-centre/Matches?$expand=homeTeam,awayTeam,venue

### 13. Players Sorting ascending 
GET {{baseurl}}/match-centre/Players?$orderby=playerName asc

### 14. Get only selected fields
GET {{baseurl}}/match-centre/Players?$select=playerName, role, jerseyNumber, isCaptain

### 15. Check the serice metadata 
GET {{baseurl}}/match-centre/$metadata



### POST requests — Create records

### 16. Create a team
POST {{baseurl}}/admin/Teams
Content-Type: application/json
Authorization: Basic {{admin}}

{"ID" : "T009",
"teamCode" : "PW",
"teamName" : "Pune Warriors",
"homeCity" : "Pune",
 "foundedYear" : "2010"
}

### 17. Create a Player
POST {{baseurl}}/admin/Players
Content-Type: application/json
Authorization: Basic {{admin}}

{
    "ID" : "P017",
    "playerName" : "AB de Villiers",
    "country" : "South Africa",
    "role" : "Batter",
    "dateOfBirth" : "1984-02-17",
    "jerseyNumber" : "17",
    "isCaptain" : true,
    "team_ID" : "T003"
}

### 18. Create a Match
POST {{baseurl}}/admin/Matches
Content-Type: application/json
Authorization: Basic {{admin}}

{
    "ID" : "M018",
    "matchDate" : "2025-04-28",
    "status" : "scheduled",
    "homeTeam_ID" : "T005",
    "awayTeam_ID" : "T003",
    "venue_ID" : "V003",
    "winner_ID" : "T003",
    "resultMargin" : "6 wickets"    
}


### PATCH requests — Update existing records

### 19. Update Match information
PATCH {{baseurl}}/admin/Matches(M008)
Content-Type: application/json
Authorization: Basic {{admin}}

{
    
}

### 20. Change in Seating capacity of Venue
PATCH {{baseurl}}/admin/Venues(V001)
Content-Type: application/json
Authorization: Basic {{admin}}

{
    "seatingCapacity" : 39001
}

### 21. Delete a Team . its players should also deleted 
DELETE {{baseurl}}/admin/Teams(T008)
Authorization: Basic {{admin}}

